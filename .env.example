# roadmap-site — build-time environment (Docker --build-arg values baked into the static bundle).
# Copy to .env.local for local dev (never commit .env.local).

# The site's name in the header and title.
# VITE_SITE_NAME=Roadmap

# One sentence for search results and link previews (fixed at build time: crawlers read the static HTML).
# VITE_SITE_DESCRIPTION=Public roadmap: what is planned, in progress and done.

# The site's public https address (optional; adds the canonical link and og:url).
# VITE_SITE_URL=https://roadmap.example.org

# The roadmap data is always same-origin (/public/v1/roadmap); there is no API URL to configure.
